{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pixie",
  "version": "0.1.0",
  "identifier": "com.pixie.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pixie",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A builtin-engine AI agent workspace for Android",
    "longDescription": "Pixie App is an Android application that provides a chat interface for interacting with the builtin Anthropic-compatible agent engine. Built with Tauri v2, React, TypeScript, and Rust."
  }
}
